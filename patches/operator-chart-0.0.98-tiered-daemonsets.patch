+  # Tiered mode: split the (non-Karpenter) sensor DaemonSet into a few
+  # DaemonSets, each pinned to a set of node-label values and carrying its own
+  # sensor resources, plus a catch-all for every other node. Applies when
+  # daemonset.enabled=true and daemonset.karpenter=false; an empty `tiers`
+  # renders exactly the single DaemonSet as before.
+  #
+  # Choose the label deliberately when nodes are provisioned by Karpenter:
+  #   - A label you set yourself on the NodePool (spec.template.metadata.labels),
+  #     e.g. attrb.io/sensor-size=large, or karpenter.sh/nodepool with NodePool
+  #     names as values. Karpenter treats these as part of the NodePool, so it
+  #     charges exactly one sensor DaemonSet to each new node.
+  #   - Instance-size labels (karpenter.k8s.aws/instance-cpu,
+  #     node.kubernetes.io/instance-type, ...) are only safe on Karpenter
+  #     >= 1.14.0. Older Karpenter cannot resolve them while planning a node
+  #     and counts every tier's DaemonSet against every new node
+  #     (kubernetes-sigs/karpenter#715, fixed by #2486 in v1.14.0).
+  # Each node must match at most one tier; a label value listed in two tiers
+  # fails the render. The catch-all uses NotIn over all listed values, so it
+  # also covers nodes without the label.
+  tierLabelKey: attrb.io/sensor-size
+  tiers: {}
+  # tiers:
+  #   large:
+  #     values: ["large", "xlarge"]      # values of tierLabelKey (or of `key`) that select this tier
+  #     # key: karpenter.sh/nodepool     # optional per-tier label key override
+  #     resources:                       # same shape as sensorresources. A cpu or memory block you set here
+  #       cpu:                           # replaces the sensorresources block as a whole (request and limit);
+  #         request: "300m"              # a block you leave out is inherited from sensorresources.
+  #         limit: "1500m"
+  #       memory:
+  #         request: "640Mi"
+  #         limit: "3Gi"
+  #     # tolerations:                   # optional, replaces daemonset.selectors.tolerations for this tier
+  #     #   - operator: Exists
